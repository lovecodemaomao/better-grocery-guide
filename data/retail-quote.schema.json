{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "可追溯零售报价",
  "type": "object",
  "required": ["city", "channel", "product", "specification", "weightKg", "listedCny", "discountCny", "shippingCny", "priceKind", "observedAt", "sourceUrl"],
  "properties": {
    "city": { "type": "string", "minLength": 1 },
    "district": { "type": "string" },
    "channel": { "type": "string", "minLength": 1 },
    "seller": { "type": "string" },
    "product": { "type": "string", "minLength": 1 },
    "variety": { "type": "string" },
    "specification": { "type": "string", "minLength": 1 },
    "weightKg": { "type": "number", "exclusiveMinimum": 0 },
    "listedCny": { "type": "number", "minimum": 0 },
    "discountCny": { "type": "number", "minimum": 0 },
    "shippingCny": { "type": "number", "minimum": 0 },
    "priceKind": { "enum": ["listing", "checkout", "paid"] },
    "observedAt": { "type": "string", "format": "date-time" },
    "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "popularityKind": { "enum": ["sales", "reviews", "unknown"] },
    "popularityCount": { "type": "integer", "minimum": 0 },
    "note": { "type": "string" }
  },
  "additionalProperties": false
}
